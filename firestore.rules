rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isRaceLocked(raceId) {
      let race = get(/databases/$(database)/documents/races/$(raceId)).data;
      return race.lockAt <= request.time;
    }

    // Which named player (if any) this browser's anonymous-auth session has
    // passcode-verified as — see the /sessions block below. Firestore rules
    // otherwise have no concept of "which player is active," only the raw
    // per-browser auth uid, so this is the one durable link between the two.
    function activePlayerId() {
      return get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.playerId;
    }

    function isOwnPlayerDoc(playerId) {
      return signedIn() && playerId == activePlayerId();
    }

    // "Submitted" here deliberately means just the main P1/P2/P3 — the same
    // bar PredictionsGrid's reveal-gate button uses client-side to decide
    // whether to offer the comparison view at all, so the two stay in sync.
    // Doesn't require exists() to short-circuit first because every
    // prediction the app ever writes always has these three keys present
    // (even as explicit nulls) from the moment the doc is created — see
    // upsertPrediction — so a straight get().data.p1 read is safe as long
    // as the doc exists, which is what exists() guards here. Safe to call
    // even when this happens to be evaluating access to the reader's own
    // doc (get() on the same path currently being evaluated) — confirmed
    // against both the emulator and production; the actual failure mode
    // that looked like a self-reference problem was really just the
    // resource == null case handled in the read rule below.
    function hasSubmittedMainPodium(raceId) {
      let ownPredId = raceId + '_' + activePlayerId();
      return exists(/databases/$(database)/documents/predictions/$(ownPredId)) &&
        get(/databases/$(database)/documents/predictions/$(ownPredId)).data.p1 != null &&
        get(/databases/$(database)/documents/predictions/$(ownPredId)).data.p2 != null &&
        get(/databases/$(database)/documents/predictions/$(ownPredId)).data.p3 != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/players/$(activePlayerId())).data.isAdmin == true;
    }

    // Binds this browser's anonymous-auth uid to whichever player last
    // passcode-verified in it. Only the browser itself can write its own
    // session doc (doc ID == its own uid), and nothing can ever read these
    // back out over the client SDK — they exist purely for other rules'
    // internal get() calls above, which bypass `allow read` entirely.
    match /sessions/{uid} {
      allow read: if false;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Calendar. Readable by anyone in the group; writes (result entry, lock
    // timestamp edits) are admin-only — see isAdmin() above. The player
    // "did I submit" flags in the /submissions subcollection below are a
    // separate match block and are NOT covered by this restriction.
    match /races/{raceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Content-free "finished their pick" flags — no p1/p2/p3 in here, so
    // it's fine for these to stay readable even while the race is open.
    // This is what the calendar's "3/5 predicted" and per-race "who's
    // still out" status is built from, without exposing anyone's picks.
    //
    // Declared with a `{path=**}` wildcard (rather than nested under
    // /races/{raceId}) because that's what Firestore requires to authorize
    // a `collectionGroup('submissions')` query — a plain nested match only
    // covers reads scoped to one race's subcollection, not the cross-race
    // group query the calendar view uses.
    match /{path=**}/submissions/{playerId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Driver grid. Admin-only — mid-season lineup swaps go through Admin now.
    match /drivers/{driverId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Named player profiles (no passwords, but passcode-protected — see
    // PasscodeSetup/PasscodeLogin). A player can always edit their own doc;
    // editing someone else's (e.g. resetting their passcode) requires admin.
    //
    // The one carve-out is first-time passcode setup: at the exact moment a
    // brand-new (or reset) player claims their passcode, no session exists
    // yet to prove "this is them" — that's what the session write right
    // after is for. So a passcode-only write is allowed on any doc that
    // doesn't have one set yet, same trust level as picking a name today;
    // once claimed, further changes need isOwnPlayerDoc() or isAdmin().
    function isClaimingPasscode() {
      return resource.data.passcodeHash == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passcodeHash', 'passcodeSetAt']);
    }

    match /players/{playerId} {
      allow read: if true;
      // isAdmin must be explicitly false at creation for an ordinary
      // sign-up — nobody grants themselves admin by adding a player. The
      // `|| isAdmin()` bypass exists only for database restore, which
      // deletes and recreates every player doc from a backup (see
      // restoreDatabaseSnapshot); without it, restoring a player who *was*
      // an admin would be permanently blocked. isAdmin is still never
      // settable through a normal update (see below) — this bypass only
      // applies to a fresh create, run by an admin, from trusted export data.
      allow create: if signedIn() && (request.resource.data.isAdmin == false || isAdmin());
      allow update: if signedIn() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']) &&
        (isOwnPlayerDoc(playerId) || isAdmin() || isClaimingPasscode());
      allow delete: if isAdmin();
    }

    // Scoring rules / app settings. Admin-only.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Predictions are the one place we actually gate reads: nobody should be
    // able to see another player's pick for a race that hasn't locked yet.
    // Every prediction doc carries the anonymous-auth uid of whoever wrote it
    // so "is this mine" can be checked without a real login system.
    //
    // Unlike the admin checks above, this still keys off the raw per-browser
    // `authUid` rather than `isOwnPlayerDoc()` / the /sessions link — so a
    // signed-in browser can technically write a prediction doc for any
    // playerId, not just whichever player it last passcode-verified as. The
    // passcode screen in the UI is what actually stops that in practice for
    // predictions. (The /sessions mechanism added for isAdmin() could tighten
    // this the same way admin writes are tightened now — deliberately left
    // out here to keep this change scoped to the admin role.)
    //
    // isAdmin() is threaded through every clause here for three admin
    // features that all need it: deleting a player cascades into deleting
    // (and first reading, to find) all of their predictions; restoring a
    // backup deletes and recreates the whole collection; and overriding a
    // player's pick works on any race, locked or not, and even creates the
    // doc fresh if that player never predicted at all.
    match /predictions/{predictionId} {
      // A player can also see the *whole race's* picks early, before lock,
      // once they've submitted their own main podium — see
      // hasSubmittedMainPodium() above. That's the read-access half of the
      // reveal feature; the write half (locking their own pick the moment
      // they do this) is the revealedAt check in `update` below.
      //
      // `resource == null ||` first: a real-time listener subscribed to a
      // prediction that doesn't exist yet (useMyPrediction, before a player
      // has ever submitted for this race — a normal, expected case) has no
      // `resource` to evaluate the rest of this against. Firestore doesn't
      // just skip evaluating the other clauses in that case, it throws —
      // and a thrown/denied error permanently kills that onSnapshot
      // listener (Firestore never auto-retries one), so without this guard
      // a player's very first-ever submission would silently never show up
      // in their own form until they reloaded the page. Confirmed this
      // isn't emulator-only — same failure against production Firestore.
      allow read: if signedIn() && (resource == null || (
        resource.data.authUid == request.auth.uid ||
        isRaceLocked(resource.data.raceId) ||
        isAdmin() ||
        hasSubmittedMainPodium(resource.data.raceId)
      ));

      allow create: if signedIn() && (
        (request.resource.data.authUid == request.auth.uid &&
          request.resource.data.raceId is string &&
          request.resource.data.playerId is string) ||
        isAdmin()
      );

      // Before lock: only the author can edit their own pick, and only if
      // they haven't revealed the comparison view for this race yet —
      // revealedAt (set the moment they open it, see revealPrediction in
      // api.js) locks it in early on purpose, same as an actual race lock
      // would, so peeking at everyone else's picks can't be used to then
      // change your own. .get() with a default here (not resource.data.
      // revealedAt directly) because older prediction docs written before
      // this feature existed don't have the key at all, and plain dot
      // access throws on a genuinely missing key rather than returning null.
      // After lock: any signed-in session may write (this is how the admin
      // results screen posts computed points back onto each prediction).
      // isAdmin() covers overriding a pick that's still open (not yet
      // locked) for someone other than the acting admin themselves.
      allow update: if signedIn() && (
        (resource.data.authUid == request.auth.uid &&
          !isRaceLocked(resource.data.raceId) &&
          resource.data.get('revealedAt', null) == null) ||
        isRaceLocked(resource.data.raceId) ||
        isAdmin()
      );

      allow delete: if signedIn() && (
        (resource.data.authUid == request.auth.uid &&
          !isRaceLocked(resource.data.raceId) &&
          resource.data.get('revealedAt', null) == null) ||
        isAdmin()
      );
    }
  }
}
